PORT=8788
# Shared secret between mobile and server. Any long random string.
AUTH_TOKEN=replace-me-with-a-real-token

# Paste your OpenRouter API key here (https://openrouter.ai/keys).
# This file is .env, which is gitignored -- it never leaves this server.
OPENROUTER_API_KEY=

# Default model + automatic fallback order both come from src/models.ts's MODELS
# list (not exposed to the app UI -- users pick an animal, never a backend model).
# This just overrides which one is tried first; leave unset to use MODELS[0].
# Model lineups shift fast; if you get "No endpoints found for <model>", check
# https://openrouter.ai/models for a current slug.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Placeholder starting token allowance for the usage page (Settings > Usage in the
# app). Real budgets get decided later -- this just proves the counting is accurate.
USAGE_TOKEN_BUDGET=100000

# Number of reverse proxies in front of this server, so rate limits and token budgets key on the
# real caller's IP. 1 = Tailscale Serve (foundry). 2 = Cloudflare -> Caddy (Hetzner, with Caddy's
# reverse_proxy trusting Cloudflare's IP ranges).
TRUST_PROXY_HOPS=1
