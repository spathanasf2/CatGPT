[Unit]
Description=Aineko production health (aineko.bromsg.com + OpenRouter credit)
Wants=network-online.target
After=network-online.target
OnFailure=cli-games-telegram-notify@%n.service

[Service]
Type=oneshot
User=noderunner
EnvironmentFile=/home/noderunner/aineko/server/.env
# Message-guard alerts first, and never fatal: they must go out even while health is failing.
ExecStartPre=-/home/noderunner/aineko/server/scripts/guard-alerts.sh
ExecStart=/home/noderunner/aineko/server/scripts/prod-health.sh
TimeoutStartSec=90
